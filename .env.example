# Optional. Leave empty on Netlify (the URL is detected). Set it when you add a custom domain, e.g. https://ahmedabdelmonem.com
VITE_SITE_URL=

# Contact form endpoint (Formspree, Web3Forms, or your own function).
# Leave empty to fall back to the visitor's mail app (mailto:).
# Example: https://formspree.io/f/xxxxxxxx
VITE_CONTACT_ENDPOINT=
